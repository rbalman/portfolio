---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";

const talks = [
  {
    title: "Managing CloudFormation Stacks at Scale",
    event: "AWS User Group Nepal",
    summary:
      "CloudFormation stacks treated as coordinated systems for microservices and immutable infrastructure.",
    description:
      "A practical look at CloudFormation limitations, dependency design, and parallel stack creation/destruction.",
    link: "https://slides.com/rbalman/managing-cloudformation-at-scale",
    linkedin:
      "https://www.linkedin.com/posts/rbalman_thank-you-aws-user-group-nepal-looking-forward-share-7056085390943748096-RORL?utm_source=share&utm_medium=member_desktop&rcm=ACoAABk8CpsBfb3FfDjqQX3Dw1tVK85v4vi8SZU",
  },
  {
    title: "Container Internals",
    event: "DevOps Kathmandu",
    summary:
      "A visual and hands-on dive into the Linux primitives behind containers.",
    description:
      "Live demo around chroot, namespaces, cgroups, and Linux security modules.",
    link: "https://slides.com/rbalman/container-internals",
    linkedin:
      "https://www.linkedin.com/feed/update/urn:li:activity:7188741371644567552/?utm_source=share&utm_medium=member_desktop&rcm=ACoAABk8CpsBfb3FfDjqQX3Dw1tVK85v4vi8SZU",
  },
  {
    title: "Deploying the career in a cloud native way",
    event: "CNCF Kathmandu",
    summary:
      "Remote work and career lessons from navigating DevOps work globally.",
    description:
      "Practical strategies for landing, growing, and thriving in remote cloud native roles.",
    link: "https://slides.com/rbalman/remote-work",
    linkedin:
      "https://www.linkedin.com/posts/cncf-kathmandu_speaker-announcement-were-excited-to-activity-7340981385496530944-cGG4?utm_source=share&utm_medium=member_desktop&rcm=ACoAABk8CpsBfb3FfDjqQX3Dw1tVK85v4vi8SZU",
  },
];

const projects = [
  {
    title: "Compose your CloudFormation stacks like docker compose",
    description: "Manage CloudFormation stacks at scale with a compose-style workflow.",
    link: "https://github.com/rbalman/cfn-compose",
    stats: [
      ["Stars", "https://img.shields.io/badge/stars-42-blue?style=flat-square&labelColor=343b41"],
      ["Forks", "https://img.shields.io/badge/forks-11-blue?style=flat-square&labelColor=343b41"],
      ["Issues", "https://img.shields.io/badge/issues-11%20open-orange?style=flat-square&labelColor=343b41"],
      ["Pull Requests", "https://img.shields.io/badge/pull%20requests-2%20open-orange?style=flat-square&labelColor=343b41"],
    ],
  },
  {
    title: "Bare minimal shell based container runtime built for fun",
    description: "A tiny shell runtime for learning container internals by building from primitives.",
    link: "https://github.com/rbalman/ship",
    stats: [
      ["Stars", "https://img.shields.io/badge/stars-3-blue?style=flat-square&labelColor=343b41"],
      ["Forks", "https://img.shields.io/badge/forks-2-blue?style=flat-square&labelColor=343b41"],
      ["Issues", "https://img.shields.io/badge/issues-1%20open-orange?style=flat-square&labelColor=343b41"],
      ["Pull Requests", "https://img.shields.io/badge/pull%20requests-1%20open-orange?style=flat-square&labelColor=343b41"],
    ],
  },
  {
    title: "Dump the CloudFormation stacks dependency as a JSON file",
    description: "A helper for inspecting CloudFormation stack dependencies in JSON form.",
    link: "https://github.com/rbalman/cfn-dump",
    stats: [
      ["Stars", "https://img.shields.io/badge/stars-8-blue?style=flat-square&labelColor=343b41"],
      ["Forks", "https://img.shields.io/badge/forks-5-blue?style=flat-square&labelColor=343b41"],
      ["Issues", "https://img.shields.io/badge/issues-1%20open-orange?style=flat-square&labelColor=343b41"],
      ["Pull Requests", "https://img.shields.io/badge/pull%20requests-1%20open-orange?style=flat-square&labelColor=343b41"],
    ],
  },
  {
    title: "See WiFi password from CLI",
    description: "A command-line utility for reading saved WiFi passwords.",
    link: "https://github.com/rbalman/wifipass",
    stats: [
      ["Stars", "https://img.shields.io/badge/stars-8-blue?style=flat-square&labelColor=343b41"],
      ["Forks", "https://img.shields.io/badge/forks-2-blue?style=flat-square&labelColor=343b41"],
