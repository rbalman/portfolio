const community = [
  {
    title: "Open-Source Captable",
    description: "Provided DevOps support for developer experience.",
    link: "https://github.com/captableinc/captable",
    stats: [
      ["Stars", "https://img.shields.io/github/stars/captableinc/captable?style=flat-square&labelColor=343b41"],
      ["Forks", "https://img.shields.io/github/forks/captableinc/captable?style=flat-square&labelColor=343b41"],
    ],
