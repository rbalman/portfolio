---

<Base
  title="Community Involvement"
  meta_title="Community Involvement"
  description="Talks, projects, teaching, and writing by Balman Rawat."
>
  <PageHeader title="Community" />

  <section class="section-sm">
    <div class="container">
      <div id="talks" class="mb-16 scroll-mt-24">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="text-h3">Talks</h2>
        </div>
        <div class="grid gap-6 lg:grid-cols-3">
          {talks.map((talk) => (
            <article class="flex h-full flex-col rounded-lg bg-light p-7 dark:bg-darkmode-light">
              <p class="mb-3 text-sm font-medium uppercase text-primary">
                {talk.event}
              </p>
              <h3 class="mb-4 text-h4">{talk.title}</h3>
              <p class="mb-4 font-medium">{talk.summary}</p>
              <p class="mb-6 grow">{talk.description}</p>
              <div class="flex flex-wrap gap-3">
                <a
                  class="btn btn-outline-primary btn-sm"
                  href={talk.link}
                  target="_blank"
                  rel="noopener"
                >
                  View slides
                </a>
                <a
                  class="btn btn-primary btn-sm"
                  href={talk.linkedin}
                  target="_blank"
                  rel="noopener"
                >
                  LinkedIn post
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div id="projects" class="mb-16 scroll-mt-24">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="text-h3">Projects</h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {projects.map((project) => (
            <a
              href={project.link}
              target="_blank"
              rel="noopener"
              class="flex h-full flex-col rounded-lg bg-light p-7 transition hover:-translate-y-1 hover:shadow-md dark:bg-darkmode-light"
            >
              <h3 class="mb-4 text-h4">{project.title}</h3>
              <p class="mb-6 grow">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.stats.map(([alt, src]) => (
                  <img src={src} alt={alt} loading="lazy" class="h-6 rounded-sm" />
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="mb-16">
        <h2 class="mb-8 text-h3">Community Involvement</h2>
        <div class="grid gap-6 md:grid-cols-2">
          {community.map((item) => (
            <a
              class="rounded-lg bg-light p-8 transition hover:-translate-y-1 hover:shadow-md dark:bg-darkmode-light"
              href={item.link}
              target="_blank"
              rel="noopener"
            >
              <h3 class="mb-4 text-h4">{item.title}</h3>
              <p class="mb-6">{item.description}</p>
              <div class="flex flex-wrap gap-2">
                {item.stats.map(([alt, src]) => (
                  <img src={src} alt={alt} loading="lazy" class="h-6 rounded-sm" />
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>

      <div id="teaching" class="scroll-mt-24">
        <div class="rounded-lg bg-light p-8 dark:bg-darkmode-light">
          <h2 class="mb-6 text-h3">Teaching</h2>
          <p>
            Conducted a two-month DevOps training class with TechAxis Nepal for
            fresh graduates, and regularly supported engineering teams through
            DevOps sessions, runbooks, PR reviews, release coordination, and
            platform documentation.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
