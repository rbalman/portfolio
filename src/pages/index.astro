---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { FaCheck } from "react-icons/fa";

const homepage = await getListPage("homepage", "-index");

const { banner, features } = homepage.data;

const certifications = [
  {
    title: "Kubestronaut",
    issuer: "Cloud Native Computing Foundation",
    focus: "CKA, CKAD, CKS, KCNA, KCSA",
    link: "https://www.credly.com/badges/31bb1576-00a0-4f13-86ea-c0cd736f1898/public_url",
    tone: "Kubestronaut",
    image: "/images/certifications/kubestronaut.png",
  },
  {
    title: "Certified Kubernetes Security Specialist",
    issuer: "Cloud Native Computing Foundation",
    focus: "cluster hardening, supply chain security, runtime security",
    link: "https://www.credly.com/badges/e2c193b2-8681-4ed2-ad38-5a714c2e5d80/public_url",
    tone: "CKS",
    image: "/images/certifications/cks.png",
  },
  {
    title: "Certified Kubernetes Administrator",
    issuer: "Cloud Native Computing Foundation",
    focus: "Kubernetes cluster operations, security, troubleshooting",
    link: "https://www.credly.com/badges/9780a1f4-f0a8-4c4c-a7ce-982c9f6e05b1/public_url",
    tone: "CKA",
    image: "/images/certifications/cka.png",
  },
  {
    title: "Certified Kubernetes Application Developer",
    issuer: "Cloud Native Computing Foundation",
    focus: "Kubernetes workloads, configuration, delivery",
    link: "https://www.credly.com/badges/28e75fd3-0b6c-43ac-a555-d690c73226bd/public_url",
    tone: "CKAD",
    image: "/images/certifications/ckad.png",
  },
  {
    title: "Kubernetes and Cloud Native Associate",
    issuer: "Cloud Native Computing Foundation",
    focus: "Kubernetes fundamentals, cloud native architecture, observability",
    link: "https://www.credly.com/badges/c58c8b53-b010-439c-9b03-c9a83a84dd4f/public_url",
    tone: "KCNA",
    image: "/images/certifications/kcna.png",
  },
  {
    title: "Kubernetes and Cloud Native Security Associate",
    issuer: "Cloud Native Computing Foundation",
    focus: "cloud native security, compliance, workload & runtime security",
    link: "https://www.credly.com/badges/814fa670-715f-4ff4-8004-1051c105cb8f/public_url",
    tone: "KCSA",
    image: "/images/certifications/kcsa.png",
  },
  {
    title: "AWS Certified DevOps Engineer - Professional",
    issuer: "Amazon Web Services",
    focus: "automation, delivery, monitoring, reliability",
    link: "https://www.credly.com/badges/ded0b0c1-69a9-4509-8b86-5d7265187543/public_url",
    tone: "AWS",
    image: "/images/certifications/aws-devops-engineer-professional.png",
    expired: true,
  },
];

const communityCards = [
  {
    title: "Talks",
    link: "/community-involvement#talks",
  },
  {
    title: "Projects",
    link: "/community-involvement#projects",
  },
  {
    title: "Teaching",
    link: "/community-involvement#teaching",
  },
];
---

<Base>
  <!-- Banner -->
  <section class="section pt-14">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-7 md:col-9 mb-8 text-center">
          <h1
            set:html={markdownify(banner.title)}
            class="mb-4 text-h3 lg:text-h1"
          />
          <p set:html={markdownify(banner.content)} class="mb-8" />
          {
            banner.button.enable && (
              <a
                class="btn btn-primary"
                href={banner.button.link}
                target={
                  banner.button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel="noopener"
              >
                {banner.button.label}
              </a>
            )
          }
        </div>
        {
          banner.image && (
            <div class="col-12">
              <ImageMod
                src={banner.image}
                height={380}
                width={1200}
                alt="banner"
                format="webp"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <!-- Features -->
  {
    features.map((feature, index: number) => (
      <section class={`section-sm ${index % 2 === 0 && "bg-gradient"}`}>
        <div class="container">
          {feature.badges ? (
            <div class="row justify-center">
              <div class="lg:col-10 text-center">
                <h2 set:html={markdownify(feature.title)} class="mb-4" />
                {feature.content && (
                  <p
                    set:html={markdownify(feature.content)}
                    class="mx-auto mb-8 max-w-3xl text-lg"
                  />
                )}
                <div class="mb-8 flex flex-wrap justify-center gap-2">
                  {feature.badges.map((badge: { alt: string; src: string }) => (
                    <img
                      src={badge.src}
                      alt={badge.alt}
                      loading="lazy"
                      class="h-7 rounded-sm"
                    />
                  ))}
                </div>
                <div class="mx-auto mb-8 grid max-w-4xl gap-4 md:grid-cols-3">
                  {feature.bulletpoints.map((bullet: string) => (
                    <div class="rounded-lg bg-body px-5 py-4 text-center shadow-sm dark:bg-darkmode-body">
                      <span set:html={markdownify(bullet)} class="font-medium" />
                    </div>
                  ))}
                </div>
                {feature.button.enable && (
                  <a class="btn btn-primary" href={feature.button.link}>
                    {feature.button.label}
                  </a>
                )}
              </div>
            </div>
          ) : feature.title === "Certifications" ? (
            <div class="row justify-center">
              <div class="lg:col-10">
                <div class="mx-auto mb-10 max-w-3xl text-center">
                  <h2 set:html={markdownify(feature.title)} class="mb-4" />
                  {feature.content && (
                    <p set:html={markdownify(feature.content)} class="text-lg" />
                  )}
                </div>
                <div class="grid gap-6 md:grid-cols-3">
                  {certifications.map((cert) => (
                    <a
                      href={cert.link}
                      target="_blank"
                      rel="noopener"
                      aria-label={`${cert.title}${cert.expired ? " (expired)" : ""}`}
                      class="relative block rounded-lg bg-body p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:bg-darkmode-body"
                    >
                      {cert.expired && (
                        <span class="absolute right-4 top-4 rounded border border-border px-2 py-0.5 text-xs font-medium text-text-light dark:border-darkmode-border dark:text-darkmode-text-light">
                          Expired
                        </span>
                      )}
                      <div class="mb-5 flex justify-center">
                        <img
                          src={cert.image}
                          alt={cert.title}
                          loading="lazy"
                          class="h-28 w-28 object-contain"
                        />
                      </div>
                      <h3 class="mb-2 text-center text-h5">{cert.title}</h3>
                      <p class="text-center font-medium text-text-dark dark:text-white">
                        {cert.issuer}
                      </p>
                    </a>
                  ))}
                </div>
                {feature.button.enable && (
                  <div class="mt-8 text-center">
                    <a class="btn btn-primary" href={feature.button.link}>
                      {feature.button.label}
                    </a>
                  </div>
                )}
              </div>
            </div>
          ) : feature.title === "Community" ? (
            <div class="row justify-center">
              <div class="lg:col-10">
                <div class="mx-auto mb-10 max-w-3xl text-center">
                  <h2 set:html={markdownify(feature.title)} class="mb-4" />
                  {feature.content && (
                    <p set:html={markdownify(feature.content)} class="text-lg" />
                  )}
                </div>
                <div class="mx-auto grid max-w-3xl gap-5 sm:grid-cols-3">
                  {communityCards.map((card) => (
                    <a
                      href={card.link}
                      class="rounded-lg bg-body p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md dark:bg-darkmode-body"
                    >
                      <h3 class="text-h5">{card.title}</h3>
                    </a>
                  ))}
                </div>
                {feature.button.enable && (
                  <div class="mt-8 text-center">
                    <a class="btn btn-primary" href={feature.button.link}>
                      {feature.button.label}
                    </a>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div class="row items-center justify-between">
              <div
                class={`mb:md-0 mb-6 md:col-5 ${index % 2 !== 0 && "md:order-2"}`}
              >
                <ImageMod
                  src={feature.image}
                  height={480}
                  width={520}
                  alt={feature.title}
                  format="webp"
                />
              </div>
              <div
                class={`md:col-7 lg:col-6 ${index % 2 !== 0 && "md:order-1"}`}
              >
                <h2 set:html={markdownify(feature.title)} class="mb-4" />
                <p set:html={markdownify(feature.content)} class="mb-8 text-lg" />
                <ul>
                  {feature.bulletpoints.map((bullet: string) => (
                    <li class="relative mb-4 pl-6">
                      <FaCheck className={"absolute left-0 top-1.5"} />
                      <span set:html={markdownify(bullet)} />
                    </li>
                  ))}
                </ul>
                {feature.button.enable && (
                  <a class="btn btn-primary mt-5" href={feature.button.link}>
                    {feature.button.label}
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      </section>
    ))
  }
  <!-- /Features -->

</Base>
