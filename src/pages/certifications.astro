---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/partials/PageHeader.astro";

const certifications = [
  {
    title: "Certified Kubernetes Administrator",
    issuer: "Cloud Native Computing Foundation",
    badge: "CKA",
    image: "/images/certifications/cka.png",
    credential:
      "https://www.credly.com/badges/9780a1f4-f0a8-4c4c-a7ce-982c9f6e05b1/public_url",
    focus: ["cluster operations", "networking", "security", "storage", "troubleshooting"],
  },
  {
    title: "Certified Kubernetes Application Developer",
    issuer: "Cloud Native Computing Foundation",
    badge: "CKAD",
    image: "/images/certifications/ckad.png",
    credential:
      "https://www.credly.com/badges/28e75fd3-0b6c-43ac-a555-d690c73226bd/public_url",
    focus: ["workloads", "configuration", "services", "storage", "troubleshooting"],
  },
  {
    title: "AWS Certified DevOps Engineer - Professional",
    issuer: "Amazon Web Services",
    badge: "AWS",
    image: "/images/certifications/aws-devops-engineer-professional.png",
    credential:
      "https://www.credly.com/badges/ded0b0c1-69a9-4509-8b86-5d7265187543/public_url",
    focus: ["automation", "CI/CD", "monitoring", "security", "resilience"],
    expired: true,
  },
];
---

<Base
  title="Certifications"
  meta_title="Certifications"
  description="Professional certifications held by Balman Rawat."
>
  <PageHeader title="Certifications" />

  <section class="section-sm">
    <div class="container">
      <div class="grid gap-6 lg:grid-cols-3">
        {certifications.map((cert) => (
          <a
            href={cert.credential}
            target="_blank"
            rel="noopener"
            aria-label={`${cert.title}${cert.expired ? " (expired)" : ""}`}
            class="group relative block rounded-lg bg-light p-8 transition hover:-translate-y-1 hover:shadow-md dark:bg-darkmode-light"
          >
            {cert.expired && (
              <span class="absolute right-4 top-4 rounded border border-border px-2 py-0.5 text-xs font-medium text-text-light dark:border-darkmode-border dark:text-darkmode-text-light">
                Expired
              </span>
            )}
            <div class="mb-6 flex justify-center">
              <img
                src={cert.image}
                alt={cert.title}
                loading="lazy"
                class="h-36 w-36 object-contain"
              />
            </div>
            <p class="mb-3 text-center text-sm font-medium uppercase text-primary">
              {cert.issuer}
            </p>
            <h2 class="mb-6 text-center text-h4">{cert.title}</h2>
            <div class="flex flex-wrap gap-2">
              {cert.focus.map((item) => (
                <span class="rounded bg-body px-3 py-1 text-sm dark:bg-darkmode-body">
                  {item}
                </span>
              ))}
            </div>
            <p class="mt-8 text-center font-medium text-primary">
              View credential
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
