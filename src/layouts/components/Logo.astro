---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src, srcDarkmode }: { src?: string; srcDarkmode?: string } =
  Astro.props;
const {
  logo,
  logo_darkmode,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_darkmode: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const { theme_switcher }: { theme_switcher: boolean } = config.settings;
---

<a href="/" class="navbar-brand inline-flex items-center gap-3">
  {
    src || srcDarkmode || logo || logo_darkmode ? (
      <>
        <ImageMod
          src={src ? src : logo}
          class={`inline-block rounded-full object-cover ring-2 ring-primary/15 ${theme_switcher && "dark:hidden"}`}
          width={logo_width.replace("px", "") * 2}
          height={logo_height.replace("px", "") * 2}
          alt={title}
          style={{
            height: logo_height.replace("px", "") + "px",
            width: logo_width.replace("px", "") + "px",
          }}
          format="webp"
        />
        {theme_switcher && (
          <ImageMod
            src={srcDarkmode ? srcDarkmode : logo_darkmode}
            class={"hidden dark:inline-block"}
            width={logo_width.replace("px", "") * 2}
            height={logo_height.replace("px", "") * 2}
            alt={title}
            style={{
              height: logo_height.replace("px", "") + "px",
              width: logo_width.replace("px", "") + "px",
            }}
            format="webp"
          />
        )}
        {logo_text && (
          <span class="font-secondary text-xl font-semibold text-text-dark dark:text-darkmode-text-dark">
            {logo_text}
          </span>
        )}
      </>
    ) : logo_text ? (
      <span class="brand-wordmark">{logo_text}</span>
    ) : (
      title
    )
  }
</a>

<style>
  .brand-wordmark {
    display: inline-block;
    font-family: var(--font-secondary), sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    color: var(--color-text-dark);
    transform: skewX(-3deg);
  }

  .brand-wordmark::after {
    content: "";
    display: block;
    height: 2px;
    width: 60%;
    margin-top: 0.18rem;
    border-radius: 999px;
    background: var(--color-primary);
    opacity: 0.85;
  }
</style>
